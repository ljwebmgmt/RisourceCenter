@model newrisourcecenter.Models.LastLoginReportViewModel
@{
    ViewBag.Title = "Users Last Login Report";
    Layout = "~/Views/Shared/_Layout.cshtml";

    long siteRole = Convert.ToInt64(Session["siteRole"]);
    long adminRole = Convert.ToInt64(Session["userRole"]);
    long companyId = Convert.ToInt64(Session["companyId"]);
}

<style type="text/css">
    /* Responsive Filter Layout */
    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 15px;
        align-items: center;
    }
    .filter-item {
        flex: 1 1 200px;
    }
    .filter-item .form-control,
    .filter-item .input-group {
        width: 100% !important;
    }
    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }
    #userTableGrid {
        height: 75vh;
        width: 100%;
    }
</style>

<script type="text/javascript">
    let gridApi;

    // Responsive Column Definitions using flex and minWidth
    const columnDefs = [
        {
            headerName: "", 
            field: "user_role", 
            width: 50,
            pinned: 'left', // Keep star visible while horizontal scrolling on mobile
            sortable: false,
            filter: false,
            cellRenderer: params => params.value === "Admin" ?
                '<span class="glyphicon glyphicon-star" style="color:red;"></span>' : ''
        },
        { headerName: "User ID", field: "usr_ID", minWidth: 90, flex: 1 },
        { headerName: "First Name", field: "usr_fName", minWidth: 120, flex: 2 },
        { headerName: "Last Name", field: "usr_lName", minWidth: 120, flex: 2 },
        { headerName: "Email", field: "usr_email", minWidth: 200, flex: 3 },
        { headerName: "Company", field: "companyName", minWidth: 160, flex: 2 },
        {
            headerName: "Last Login",
            field: "usr_lastLogin",
            minWidth: 160,
            flex: 2,
            valueFormatter: params => {
                if (!params.value) return "-";
                // Convert C# JSON Date /Date(123456789)/ to readable string
                const date = new Date(parseInt(params.value.replace(/\/Date\((\d+)\)\//, '$1')));
                return date.toLocaleString();
            }
        },
        {
            headerName: "Status", 
            field: "inactive", 
            minWidth: 110,
            flex: 1,
            cellRenderer: params => params.value ?
                '<span class="label label-default">In-active</span>' :
                '<span class="label label-success">Active</span>'
        }
    ];

    const gridOptions = {
        columnDefs: columnDefs,
        rowModelType: 'infinite',
        pagination: true,
        paginationPageSize: 100,
        cacheBlockSize: 100,
        onGridReady: params => {
            gridApi = params.api;
            params.api.setGridOption('datasource', loginDataSource);

            // Fit columns on wide screens, allow natural scroll on mobile
            if (window.innerWidth > 768) {
                params.api.sizeColumnsToFit();
            }
        },
        onGridSizeChanged: params => {
            if (window.innerWidth > 768) {
                params.api.sizeColumnsToFit();
            }
        },
        overlayLoadingTemplate: '<span class="ag-overlay-loading-center">Please wait while users load...</span>',
        overlayNoRowsTemplate: '<span style="padding: 10px; border: 2px solid #444; background: lightgoldenrodyellow;">No users found for this filter.</span>'
    };

    const loginDataSource = {
        getRows: (params) => {
            if (gridApi) {
                gridApi.setGridOption('loading', true);
            }

            const compName = $('#companySearch').val();
            const compId = $(`#companies option[value="${compName}"]`).attr('data-id') || 0;
            const locId = $('#locFilter').val() || 0;

            fetch(`/UserViewModels/GetUsersPaged?start=${params.startRow}&limit=100&compid=${compId}&locid=${locId}`)
                .then(res => res.json())
                .then(data => {
                    gridApi.setGridOption('loading', false);
                    params.successCallback(data.rows, data.total);
                    if (data.total === 0) gridApi.showNoRowsOverlay();
                    else gridApi.hideOverlay();
                })
                .catch(() => {
                    if (gridApi) gridApi.setGridOption('loading', false);
                    params.failCallback();
                });
        }
    };

    function onCompanyFilterChange() {
        const compName = $('#companySearch').val();
        const compId = $(`#companies option[value="${compName}"]`).attr('data-id');

        if (compId) {
            // Fetch locations for the selected company
            fetch(`/UserViewModels/GetLocations?compid=${compId}`)
                .then(res => res.json())
                .then(data => {
                    const locSelect = $('#locFilter');
                    locSelect.empty().append('<option value="0">All Locations</option>');
                    data.forEach(l => locSelect.append(`<option value="${l.id}">${l.name}</option>`));
                    $('#locContainer').show();
                    onFilterChange();
                });
        } else {
            $('#locContainer').hide();
            onFilterChange();
        }
    }

    function onFilterChange() {
        if (gridApi) {
            gridApi.refreshInfiniteCache();
        }
    }

    function downloadLastLoginCSV() {
        const compName = $('#companySearch').val();
        const compId = $(`#companies option[value="${compName}"]`).attr('data-id') || 0;
        window.location.href = `/UserViewModels/ExportLastLoginCSV?compid=${compId}&locid=${$('#locFilter').val() || 0}`;
    }

    document.addEventListener('DOMContentLoaded', () => {
        const gridDiv = document.querySelector('#userTableGrid');
        gridApi = agGrid.createGrid(gridDiv, gridOptions);
    });
</script>

@if (User.IsInRole("Super Admin") || User.IsInRole("Local Admin") || User.IsInRole("Global Admin"))
{
    <div class="filter-bar">
        <div class="filter-item">
            <div class="input-group">
                <input type="text" id="companySearch" class="form-control" placeholder="Search Company...." list="companies" />
                <span class="input-group-btn">
                    <button class="btn btn-primary" onclick="onCompanyFilterChange()">Filter</button>
                </span>
            </div>
            <datalist id="companies">
                @foreach (var item in ViewBag.compData)
                {
                    <option value="@item.name" data-id="@item.id">@item.name</option>
                }
            </datalist>
        </div>

        <div id="locContainer" class="filter-item" style="display:none;">
            <select id="locFilter" class="form-control" onchange="onFilterChange()">
                <option value="0">All Locations</option>
            </select>
        </div>

        <div class="filter-item" style="flex: 0 0 auto;">
            <button class="btn btn-success" onclick="downloadLastLoginCSV()">
                <span class="glyphicon glyphicon-download-alt"></span> Download CSV
            </button>
        </div>
    </div>
}

<p class="glyphicon glyphicon-star" style="color:#E50043;font-size:14px;"> - Administrator</p>

<div class="table-wrapper" style="clear:both;">
    <div id="userTableGrid" class="ag-theme-quartz"></div>
</div>