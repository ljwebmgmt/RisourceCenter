@model IEnumerable<newrisourcecenter.Models.UserViewModel>
@{
    ViewBag.Title = "User Export with Registration Date";
    Layout = "~/Views/Shared/_Layout.cshtml";

    long siteRole = Convert.ToInt64(Session["siteRole"]);
    long adminRole = Convert.ToInt64(Session["userRole"]);
    long companyId = Convert.ToInt64(Session["companyId"]);
}

<style type="text/css">
    /* Responsive Filter Layout */
    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 15px;
        align-items: center;
    }
    .filter-item {
        flex: 1 1 200px;
    }
    .filter-item .form-control,
    .filter-item .input-group {
        width: 100% !important;
        max-width: 100% !important;
    }
    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }
    #userTableGrid {
        height: 75vh;
        width: 100%;
    }
</style>

<script type="text/javascript">
    let gridApi;

    // Responsive Column Definitions using flex and minWidth
    const columnDefs = [
        {
            headerName: "",
            field: "user_role",
            width: 50,
            pinned: 'left', // Keep the star visible while horizontal scrolling on mobile
            sortable: false,
            filter: false,
            cellRenderer: params => params.value === "Admin" ?
                '<span class="glyphicon glyphicon-star" style="color:red;"></span>' : ''
        },
        { headerName: "User ID", field: "usr_ID", minWidth: 90, flex: 1, sortable: true },
        { headerName: "First Name", field: "usr_fName", minWidth: 120, flex: 2, sortable: true },
        { headerName: "Last Name", field: "usr_lName", minWidth: 120, flex: 2, sortable: true },
        { headerName: "Email", field: "usr_email", minWidth: 200, flex: 3, sortable: true },
        {
            headerName: "Status",
            field: "inactive",
            minWidth: 110,
            flex: 1,
            sortable: true,
            cellRenderer: params => {
                if (!params.data) return '';
                return params.value ?
                    '<span class="label label-default">In-active</span>' :
                    '<span class="label label-success">Active</span>';
            }
        },
        { headerName: "Registration Date", field: "registrationDate", minWidth: 120, flex: 1, sortable: true, valueGetter: params => params.data.registrationDate, comparator: (valueA, valueB, nodeA, nodeB) => {
            const dateA = nodeA.data.registrationDateRaw ? new Date(nodeA.data.registrationDateRaw) : null;
            const dateB = nodeB.data.registrationDateRaw ? new Date(nodeB.data.registrationDateRaw) : null;
            if (dateA === null && dateB === null) return 0;
            if (dateA === null) return 1;
            if (dateB === null) return -1;
            return dateA.getTime() - dateB.getTime();
        }}
    ];

    const gridOptions = {
        columnDefs: columnDefs,
        rowModelType: 'clientSide',
        pagination: true,
        paginationPageSize: 20,
        onGridReady: params => {
            gridApi = params.api;
            loadAllData();

            // Fit columns on wide screens, allow natural scroll on mobile
            if (window.innerWidth > 768) {
                params.api.sizeColumnsToFit();
            }
        },
        onGridSizeChanged: params => {
            if (window.innerWidth > 768) {
                params.api.sizeColumnsToFit();
            }
        },
        overlayLoadingTemplate: '<span class="ag-overlay-loading-center">Please wait while users load...</span>',
        overlayNoRowsTemplate: '<span style="padding: 10px; border: 2px solid #444; background: lightgoldenrodyellow;">No users found for this filter.</span>'
    };

    function loadAllData() {
        gridApi.setGridOption('loading', true);

        const compName = $('#companySearch').val();
        const compId = $(`#companies option[value="${compName}"]`).attr('data-id') || 0;
        const locId = $('#locFilter').val() || 0;
        const startDate = $('#startDate').val();
        const endDate = $('#endDate').val();

        let url = `/UserViewModels/GetUsersPagedWithRegistrationDate?start=0&limit=10000&compid=${compId}&locid=${locId}`;
        if (startDate) {
            url += `&startDate=${startDate}`;
        }
        if (endDate) {
            url += `&endDate=${endDate}`;
        }

        fetch(url)
            .then(res => res.json())
            .then(data => {
                gridApi.setGridOption('loading', false);
                gridApi.setGridOption('rowData', data.rows);
                if (data.total === 0) gridApi.showNoRowsOverlay();
                else gridApi.hideOverlay();
            })
            .catch(() => {
                gridApi.setGridOption('loading', false);
                gridApi.showNoRowsOverlay();
            });
    }

    function setDefaultDateRange() {
        const today = new Date();
        const threeMonthsAgo = new Date();
        threeMonthsAgo.setMonth(today.getMonth() - 3);

        // Format dates as YYYY-MM-DD for date input
        const formatDate = (date) => {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        };

        $('#startDate').val(formatDate(threeMonthsAgo));
        $('#endDate').val(formatDate(today));
    }

    function onCompanyFilterChange() {
        const compName = $('#companySearch').val();
        const compId = $(`#companies option[value="${compName}"]`).attr('data-id');

        if (compId) {
            fetch(`/UserViewModels/GetLocations?compid=${compId}`)
                .then(res => res.json())
                .then(data => {
                    const locSelect = $('#locFilter');
                    locSelect.empty().append('<option value="0">All Locations</option>');
                    data.forEach(l => locSelect.append(`<option value="${l.id}">${l.name}</option>`));
                    $('#locContainer').show();
                    loadAllData();
                });
        } else {
            $('#locContainer').hide();
            loadAllData();
        }
    }

    function onFilterChange() {
        loadAllData();
    }

    function resetFilters() {
        $('#companySearch').val('');
        $('#locFilter').val('0');
        $('#locContainer').hide();
        $('#startDate').val('');
        $('#endDate').val('');
        loadAllData();
    }

    function downloadCSV() {
        const compName = $('#companySearch').val();
        const compId = $(`#companies option[value="${compName}"]`).attr('data-id') || 0;
        const startDate = $('#startDate').val();
        const endDate = $('#endDate').val();

        let url = `/UserViewModels/ExportCSVWithRegistrationDate?compid=${compId}&locid=${$('#locFilter').val() || 0}`;
        if (startDate) {
            url += `&startDate=${startDate}`;
        }
        if (endDate) {
            url += `&endDate=${endDate}`;
        }
        window.location.href = url;
    }

    document.addEventListener('DOMContentLoaded', () => {
        const gridDiv = document.querySelector('#userTableGrid');
        gridApi = agGrid.createGrid(gridDiv, gridOptions);

        // Set default date range (last year) and load data
        setDefaultDateRange();
        loadAllData();
    });
</script>

@if (User.IsInRole("Super Admin") || User.IsInRole("Local Admin") || User.IsInRole("Global Admin"))
{
    <div class="filter-bar">
        <div class="filter-item">
            <div class="input-group">
                <input type="text" id="companySearch" class="form-control" placeholder="Search Company...." list="companies" />
                <span class="input-group-btn">
                    <button class="btn btn-primary" onclick="onCompanyFilterChange()">Filter</button>
                </span>
            </div>
            <datalist id="companies">
                @foreach (var item in ViewBag.compData)
                {
                    <option value="@item.name" data-id="@item.id">@item.name</option>
                }
            </datalist>
        </div>

        <div id="locContainer" class="filter-item" style="display:none;">
            <select id="locFilter" class="form-control" onchange="onFilterChange()">
                <option value="0">All Locations</option>
            </select>
        </div>

        <div class="filter-item">
            <input type="date" id="startDate" class="form-control" placeholder="Start Date" onchange="onFilterChange()" />
        </div>

        <div class="filter-item">
            <input type="date" id="endDate" class="form-control" placeholder="End Date" onchange="onFilterChange()" />
        </div>

        <div class="filter-item" style="flex: 0 0 auto;">
            <button class="btn btn-primary" onclick="downloadCSV()">Download CSV</button>
        </div>

        <div class="filter-item" style="flex: 0 0 auto;">
            <button class="btn btn-default" onclick="resetFilters()">Reset Filters</button>
        </div>
    </div>
}

<p class="glyphicon glyphicon-star" style="color:#E50043;font-size:14px;"> - Administrator</p>

<div class="table-wrapper" style="clear:both;">
    <div id="userTableGrid" class="ag-theme-quartz"></div>
</div>
