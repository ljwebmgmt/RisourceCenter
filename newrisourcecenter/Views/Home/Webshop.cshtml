@model newrisourcecenter.Models.ListWebshops

@{
    ViewBag.Title = "Stockcheck";
    Layout = null;
}
<style>
    body {
        font-family: "Helvetica Neue",Arial,sans-serif;
        background: #efefef;
        padding: 5px;
        font-family: "Source Sans Pro","Helvetica Neue",Helvetica,Arial,sans-serif;
        overflow-y: auto;
    }

    table {
        border-spacing: 0;
        margin: 0;
        max-width: 100%;
        background-color: transparent;
        display: table;
        width: 100%;
        font-size: 12px;
    }

    .table thead > tr > th {
        vertical-align: bottom;
    }

    .table thead > tr > th, .table tbody > tr > th, .table tfoot > tr > th, .table thead > tr > td, .table tbody > tr > td, .table tfoot > tr > td {
        padding: 8px;
        line-height: 1.428571429;
        vertical-align: top;
        border: none;
    }

    .login-link {
        font-size: 12px;
        color: #fff;
        padding: 5px;
    }

    .btn-primary {
        background: #E50043;
        border-color: #E50043;
        font-size: 16px;
    }

        .btn-primary:hover {
            background: #000;
            border-color: #E50043;
        }

    .btn-sm {
        padding: 5px;
        line-height: 1.5;
        color: #ffffff;
        text-decoration: none;
        cursor: pointer;
    }

    a {
        color: #ffffff;
        text-decoration: none;
    }

    .scroll-wrapper {
        max-height: 200px;
        overflow-y: auto;
        margin: 15px 0;
    }

    .search {
        float: right;
        width: 300px;
    }

    .clearfix {
        clear: both;
    }

    .pointer {
        cursor: pointer;
    }

    .header-row.pointer .header.clickable {
        background-image: url(/images/png/glyphicons-191-plus-sign.png);
        padding-left: 25px;
        background-size: 17px;
        background-repeat: no-repeat;
        background-position: 5px center;
    }

    .header-row.pointer.collapsed .header.clickable {
        background-image: url(/images/png/glyphicons-192-minus-sign.png);
    }

    .user-account-row {
        background: #CCC;
        margin-bottom: 5px;
        padding: 12px 15px;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .user-account-row span:first-child {
        font-weight: bold;
        font-size: 14px;
        color: #333;
    }

    .user-account-buttons {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .user-account-buttons a,
    .user-account-buttons button {
        padding: 6px 12px;
        font-size: 12px;
        border-radius: 3px;
        text-decoration: none;
        cursor: pointer;
        border: none;
        color: #fff;
        font-weight: 500;
        white-space: nowrap;
    }

    .btn-login {
        background: #E50043;
    }

    .btn-login:hover {
        background: #c90038;
    }

    .btn-edit {
        background: #5bc0de;
    }

    .btn-edit:hover {
        background: #46b8da;
    }

    .btn-delete {
        background: #d9534f;
    }

    .btn-delete:hover {
        background: #c9302c;
    }
</style>
<script src="~/Scripts/jquery-3.1.0.min.js"></script>
<script type="text/javascript">
    $(document).on('click', 'tr.header-row.pointer th.clickable', function (e) {
        e.preventDefault();
        var row = $(this).parent('tr');
        var bCollapse = row.hasClass('collapsed');
        var table = row.parents('table.table');
        if (bCollapse)
            $('tbody', table).slideUp();
        else {
            $('tbody', table).slideDown();
        }
        row.toggleClass('collapsed');
        return false;
    });

    $(document).on('keyup', 'input.search', function (e) {
        var val = $(this).val();
        if (val == '')
            $('table.table').show();
        if (val.length < 3)
            return;
        val = val.toLowerCase().trim();
        $('table.table').hide();
        $('table.table').each(function () {
            if ($(this).attr('data-company').indexOf(val) > -1 || $(this).attr('data-account').indexOf(val) > -1)
                $(this).show();
        });
    })

    // Load user accounts on page load
    $(document).ready(function () {
        loadUserAccounts();
    });

    function loadUserAccounts() {
        $.get('/Webshop/GetUserAccounts', function (response) {
            if (response.success) {
                renderUserAccounts(response.accounts);
            }
        });
    }

    function renderUserAccounts(accounts) {
        var container = $('#userAccountsContainer');
        container.empty();
        
        if (accounts.length === 0) {
            container.hide();
            return;
        }

        container.show();
        accounts.forEach(function (account) {
            var loginUrl = 'https://www.rittal.com/us-en/shop/login?login=' + encodeURIComponent(account.EmailAddress) + '&password=' + encodeURIComponent(account.Password);
            var html = '<div class="user-account-row">' +
                '<span>' + account.AccountName + '</span>' +
                '<div class="user-account-buttons">' +
                '<a href="' + loginUrl + '" target="_blank" class="btn-login">Login</a>' +
                '<button onclick="editUserAccount(' + account.Id + ', \'' + account.AccountName.replace(/'/g, "\\'") + '\', \'' + account.EmailAddress.replace(/'/g, "\\'") + '\', \'' + account.Password.replace(/'/g, "\\'") + '\')" class="btn-edit">Edit</button>' +
                '<button onclick="deleteUserAccount(' + account.Id + ')" class="btn-delete">Delete</button>' +
                '</div>' +
                '</div>';
            container.append(html);
        });
    }

    function openAddAccountModal() {
        // Send message to parent to open modal in add mode
        window.parent.postMessage({
            type: 'openWebshopModal',
            mode: 'add'
        }, '*');
    }

    function editUserAccount(id, accountName, emailAddress, password) {
        // Send message to parent to open modal in edit mode with data
        window.parent.postMessage({
            type: 'openWebshopModal',
            mode: 'edit',
            id: id,
            accountName: accountName,
            emailAddress: emailAddress,
            password: password
        }, '*');
    }

    function closeAddAccountModal() {
        // Send message to parent to close modal
        window.parent.postMessage({ type: 'closeWebshopModal' }, '*');
    }

    // Listen for messages from parent
    window.addEventListener('message', function(event) {
        if (event.data.type === 'saveWebshopAccount') {
            saveWebshopAccountFromParent(event.data);
        } else if (event.data.type === 'reloadWebshopAccounts') {
            loadUserAccounts();
        }
    });

    function saveWebshopAccountFromParent(data) {
        var accountName = data.accountName;
        var emailAddress = data.emailAddress;
        var password = data.password;
        var editingId = data.id;

        if (editingId) {
            // Update existing account
            $.post('/Webshop/UpdateUserAccount', {
                id: editingId,
                accountName: accountName,
                emailAddress: emailAddress,
                password: password
            }, function (response) {
                if (response.success) {
                    window.parent.postMessage({ type: 'closeWebshopModal' }, '*');
                    window.parent.postMessage({ type: 'webshopAccountSaved' }, '*');
                    window.parent.postMessage({ type: 'resetSaveButton' }, '*');
                } else {
                    window.parent.postMessage({ type: 'resetSaveButton' }, '*');
                    alert(response.message || 'Error updating account');
                }
            }).fail(function () {
                window.parent.postMessage({ type: 'resetSaveButton' }, '*');
                alert('Error updating account');
            });
        } else {
            // Add new account
            $.post('/Webshop/AddUserAccount', {
                accountName: accountName,
                emailAddress: emailAddress,
                password: password
            }, function (response) {
                if (response.success) {
                    window.parent.postMessage({ type: 'closeWebshopModal' }, '*');
                    window.parent.postMessage({ type: 'webshopAccountSaved' }, '*');
                    window.parent.postMessage({ type: 'resetSaveButton' }, '*');
                } else {
                    window.parent.postMessage({ type: 'resetSaveButton' }, '*');
                    alert(response.message || 'Error saving account');
                }
            }).fail(function () {
                window.parent.postMessage({ type: 'resetSaveButton' }, '*');
                alert('Error saving account');
            });
        }
    }

    function deleteUserAccount(id) {
        if (!confirm('Are you sure you want to delete this account?')) {
            return;
        }

        $.post('/Webshop/DeleteUserAccount', { id: id }, function (response) {
            if (response.success) {
                loadUserAccounts();
            } else {
                alert(response.message || 'Error deleting account');
            }
        }).fail(function () {
            alert('Error deleting account');
        });
    }
</script>

<strong>
    My Online Shop Accounts (<a style="color:inherit;text-decoration:underline;" href="https://risourcecenter.com/attachments/risources/Distributor-Online-Shop-Instruction-Manual.pdf" target="_blank">Instructions</a>)
    @if (User.IsInRole("Super Admin") || User.IsInRole("Local Admin") || User.IsInRole("Global Admin"))
    {
        @*@Html.ActionLink("Manage SAP Account", "Index", "partnerStockCheck", routeValues: new { n1_name = "User Admin", n2_name = "SAP Accounts", msg = Model.usr_full_name, compid = companyId, user_ID = userId, back = "home" }, htmlAttributes: new { @class = "btn-sm btn-primary" })*@
        <a target="_parent" class="btn-sm btn-primary" href="/Webshop?n1_name=User%20Admin&amp;n2_name=Online%20Shop%20Accounts&amp;msg=@ViewBag.fullname&amp;compid=@ViewBag.companyId&amp;user_ID=@ViewBag.userId&amp;back=home">Manage</a>
    }
    <button class="btn-sm btn-primary" onclick="openAddAccountModal()">Add Account</button>
    <input type="text" placeholder="Search Company name or account....." class="search" />
</strong>
<div class="clearfix"></div>

<div id="userAccountsContainer" style="margin-bottom: 15px;"></div>

<div class="scroll-wrapper">
    @if (@Model != null)
    {
        foreach (var item in @Model.Distinct_stockPrice.GroupBy(ac => new { ac.ws_account, ac.ws_password, ac.comp_name, ac.ws_user, ac.sap_account, ac.comp_industry, ac.comp_audience }).OrderBy(a => a.Key.comp_name))
        {
            <table class="table" data-company="@item.Key.comp_name.ToLower()" data-account="@item.Key.sap_account" style="margin-bottom:10px;">
                <thead>
                    <tr style="background:#999;" class="header-row pointer">
                        <th class="header clickable" align="left" style="vertical-align: middle;">@item.Key.comp_name | @item.Key.comp_industry | @item.Key.comp_audience</th>
                        <th align="right" class="clickable" width="30%" style="vertical-align: middle;">Account Number: @item.Key.sap_account</th>
                        <th align="right" width="10%" style="vertical-align: middle;">
                            @{
                                //var login = String.Format("https://www.rittal.com/us-en/content/en/wishlist/wishlist.jsp?userid={0}&passwd={1}", @item.Key.ws_account, @item.Key.ws_password);
                                var login = String.Format("https://www.rittal.com/us-en/shop/login?login={0}&password={1}", @item.Key.ws_user, @item.Key.ws_password);
                                <a href="@login" target="_blank" class="btn-primary login-link">Login</a>
                            }
                        </th>
                    </tr>
                </thead>
                <tbody style="display:none;">
                    <tr style="background:#CCC;">
                        <th class="header" align="left" colspan="3">Location(s)</th>
                    </tr>
                    <tr>
                        <td colspan="3">
                            @{
                                foreach (var stockPrice in @Model.stockPrice.GroupBy(a => new { a.sap_account, a.ws_account, a.ws_password, a.loc_city, a.loc_state }).OrderBy(a => a.Key.loc_city))
                                {
                                    if (stockPrice.Key.ws_password == item.Key.ws_password && stockPrice.Key.ws_account == item.Key.ws_account && stockPrice.Key.ws_password != null && stockPrice.Key.sap_account == item.Key.sap_account)
                                    {
                                        <span style="border-bottom:#000 1px solid;">@stockPrice.Key.loc_city, @stockPrice.Key.loc_state</span>
                                        <br />
                                    }
                                }
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        }
    }
    else
    {
        <br /><br />
        <div>You do not have any Online Shop Accounts assigned to you</div>
    }
</div>
