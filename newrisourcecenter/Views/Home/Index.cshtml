@model newrisourcecenter.Models.HomeViewModel
@{
    ViewBag.Title = "Home Page";
    long userId = Convert.ToInt64(Session["userId"]);
    long companyId = Convert.ToInt64(Session["companyId"]);
    long companyType = Convert.ToInt64(Session["companyType"]);
    string host = "";
    int comp_MDF = Convert.ToInt32(Session["comp_MDF"]);
    string[] dropdown_pages = {"104","67","30129","116" };
    string my_pages = Convert.ToString(Session["userPages"]);
    string[] user_pages = { };
    if (my_pages != null)
    {
        user_pages = my_pages.Split(',');
    }
}
@if (companyId != Model.comp_ID)
{
   <script>window.location.href = "/Account/Login/";</script>
}

<article class="main_content page">
    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-copy">
            <h1>Welcome back, @Model.usr_fName</h1>
            <p>Your Rittal sales and support resource center.</p>
            <small>Faster – better – everywhere.</small>
        </div>
        <div class="hero-art">
            <div class="cabinet c1"></div>
            <div class="cabinet c3"></div>
            <div class="cabinet c5"></div>
            <div class="cabinet c2"></div>
            <div class="cabinet c4"></div>
        </div>
    </section>

    <div class="grid-home">
        <div>
            <!-- What's New for You Section -->
            <section class="panel">
                <div class="panel-head">
                    <div>
                        <h2>What's New for You</h2>
                        <small>Latest sales tools, collateral and announcements.</small>
                    </div>
                    <a class="link" href="~/SalesCommunication">View All →</a>
                </div>
                <div class="cards">
                    @if (ViewBag.recentComms != null && ViewBag.recentComms.Count > 0)
                    {
                        int cardIndex = 0;
                        foreach (var comm in ViewBag.recentComms)
                        {
                            string mediaClass = cardIndex % 4 == 0 ? "" : cardIndex % 4 == 1 ? "alt" : cardIndex % 4 == 2 ? "data" : "video";
                            string badgeText = cardIndex == 0 ? "NEW" : cardIndex == 1 ? "UPDATED" : cardIndex == 2 ? "WATCH" : "NEW";
                            <article class="card">
                                <div class="card-media @mediaClass"><span class="badge">@badgeText</span></div>
                                <div class="card-body">
                                    <h3>@comm.sc_headline</h3>
                                    <p>@comm.sc_teaser</p>
                                    <a class="link" href="~/SalesCommunication/Index?n3id=@comm.n3ID">View Details →</a>
                                </div>
                            </article>
                            cardIndex++;
                        }
                    }
                    else if (ViewBag.recentResources != null && ViewBag.recentResources.Count > 0)
                    {
                        int cardIndex = 0;
                        foreach (var resource in ViewBag.recentResources)
                        {
                            string mediaClass = cardIndex % 4 == 0 ? "" : cardIndex % 4 == 1 ? "alt" : cardIndex % 4 == 2 ? "data" : "video";
                            string badgeText = cardIndex == 0 ? "NEW" : cardIndex == 1 ? "UPDATED" : cardIndex == 2 ? "WATCH" : "NEW";
                            <article class="card">
                                <div class="card-media @mediaClass"><span class="badge">@badgeText</span></div>
                                <div class="card-body">
                                    <h3>@resource.ris_headline</h3>
                                    <p>@resource.ris_teaser</p>
                                    <a class="link" href="~/RiSources/Index">View Resource →</a>
                                </div>
                            </article>
                            cardIndex++;
                        }
                    }
                    else
                    {
                        <!-- Fallback static cards if no data -->
                        <article class="card">
                            <div class="card-media"><span class="badge">NEW</span></div>
                            <div class="card-body">
                                <h3>Welcome to RiSource Center</h3>
                                <p>Your sales and support resource center.</p>
                                <a class="link" href="~/SalesCommunication">Explore →</a>
                            </div>
                        </article>
                    }
                </div>
            </section>

            <!-- Section Tiles -->
            <section class="panel" style="margin-top:10px">
                <div class="section-tiles">
                    <article class="section-tile">
                        <div class="art"></div>
                        <div class="content">
                            <h3>Communications</h3>
                            <p>Product updates, program announcements and more.</p>
                            <a class="link" href="~/SalesCommunication">View Communications →</a>
                        </div>
                    </article>
                    <article class="section-tile">
                        <div class="art"></div>
                        <div class="content">
                            <h3>Sales Resources</h3>
                            <p>Sell sheets, presentations, competitive info and more.</p>
                            <a class="link" href="~/Resources">Browse Resources →</a>
                        </div>
                    </article>
                    <article class="section-tile">
                        <div class="art"></div>
                        <div class="content">
                            <h3>Training & Rittal University</h3>
                            <p>Live and on-demand training to grow your expertise.</p>
                            <a class="link" href="#">Start Learning →</a>
                        </div>
                    </article>
                    <article class="section-tile">
                        <div class="art"></div>
                        <div class="content">
                            <h3>Marketing Tools</h3>
                            <p>Logos, campaign assets, images and co-op resources.</p>
                            <a class="link" href="~/Resources">Explore Tools →</a>
                        </div>
                    </article>
                </div>
            </section>
        </div>

        <!-- Sidebar -->
        <aside class="sidebar">
            <!-- My Accounts -->
            <section class="side-panel">
                <h3>My Accounts <a class="link" style="float:right;font-size:12px" href="~/partnerLocation">Manage</a></h3>
                <div style="margin-bottom:12px;">
                    <strong style="font-size:14px;">@Model.company_name</strong>
                    <div style="font-size:12px;color:#666;margin-top:4px;">@Model.Location</div>
                </div>
                <ul class="side-list">
                    <li><a href="~/UserViewModels/Edit/@userId?n1_name=Admin%20Users&msg=@User.Identity.GetUserName()&compid=@companyId&user_ID=@userId&n2_name=SAP%20Accounts" style="color:inherit;">My Profile <span>›</span></a></li>
                    <li><a href="~/partnerLocation" style="color:inherit;">Company Settings <span>›</span></a></li>
                    <li><a href="~/Webshop" style="color:inherit;">Online Shop Accounts <span>›</span></a></li>
                    <li><a href="~/MDFView" style="color:inherit;">MDF / Co-op Funds <span>›</span></a></li>
                    <li><a href="~/SPA" style="color:inherit;">SPA / Rebates <span>›</span></a></li>
                </ul>
            </section>

            <!-- Quick Actions -->
            <section class="side-panel">
                <h3>Quick Actions</h3>
                <div class="quick-actions">
                    <button class="quick" onclick="window.location.href='~/StockCheck'" style="cursor:pointer;"><i>⌕</i>Price & Availability</button>
                    <button class="quick" onclick="window.location.href='~/OrderStatus'" style="cursor:pointer;"><i>▤</i>Order Status</button>
                    <button class="quick" onclick="window.location.href='~/Webshop'" style="cursor:pointer;"><i>🛒</i>Online Shop</button>
                    <button class="quick" onclick="window.location.href='~/ProductConfig'" style="cursor:pointer;"><i>⚙</i>Product Configurators</button>
                    <button class="quick" onclick="window.location.href='~/Support'" style="cursor:pointer;"><i>◉</i>Technical Support</button>
                    <button class="quick" onclick="window.location.href='~/Documents'" style="cursor:pointer;"><i>▧</i>Find Product Documents</button>
                </div>
            </section>

            <!-- Latest Updates -->
            <section class="side-panel">
                <h3>Latest Updates <a class="link" style="float:right;font-size:12px" href="~/SalesCommunication">View All →</a></h3>
                <ul class="side-list">
                    @if (ViewBag.recentComms != null && ViewBag.recentComms.Count > 0)
                    {
                        int updateIndex = 0;
                        foreach (var comm in ViewBag.recentComms.Take(4))
                        {
                            string tagClass = updateIndex % 4 == 0 ? "tag-red" : updateIndex % 4 == 1 ? "tag-green" : updateIndex % 4 == 2 ? "tag-orange" : "tag-blue";
                            string tagText = updateIndex % 4 == 0 ? "NEW RESOURCE" : updateIndex % 4 == 1 ? "PRODUCT UPDATE" : updateIndex % 4 == 2 ? "ANNOUNCEMENT" : "EVENT";
                            <li><span class="update-tag @tagClass">@tagText</span><span>@comm.sc_headline</span></li>
                            updateIndex++;
                        }
                    }
                    else
                    {
                        <li><span class="update-tag tag-red">NEW RESOURCE</span><span>VX Double Door Sell Sheet</span></li>
                        <li><span class="update-tag tag-green">PRODUCT UPDATE</span><span>New CMC Platform Sensors</span></li>
                        <li><span class="update-tag tag-orange">ANNOUNCEMENT</span><span>Holiday Shipping Schedule</span></li>
                        <li><span class="update-tag tag-blue">EVENT</span><span>Rittal at PACK EXPO</span></li>
                    }
                </ul>
            </section>

            <!-- My RiSource -->
            <section class="side-panel">
                <h3>My RiSource</h3>
                <ul class="side-list">
                    <li>Recently Viewed <strong>12</strong></li>
                    <li>Saved Resources <strong>8</strong></li>
                    <li>My Downloads <strong>23</strong></li>
                    <li>My Collections <strong>4</strong></li>
                </ul>
            </section>
        </aside>
    </div>

    <!-- Existing iframes and functionality -->
    <div style="margin-top:20px;">
        <div class="dropdown">
            <button class="btn-xs btn-primary dropdown-toggle" type="button" data-toggle="dropdown" style="border:none;">
                I want to <span class="glyphicon glyphicon-list"></span>
                <span class="caret"></span>
            </button>
            <ul class="dropdown-menu">
                @foreach (var item in ViewBag.list_n2_data)
                {
                    if (@item.n2ID == 6)
                    {
                        if (user_pages.Contains("6"))
                        {
                            <li><a href="/MDFView?parentId=3&childId=6&n1_name=Support%20Tools&n2_name=Brand%20Central&submenu=yes">Submit an MDF Request</a></li>
                        }
                    }
                    else
                    {
                        string id = Convert.ToString(@item.n2ID);

                        if (@dropdown_pages.Contains(id))
                        {
                            if (string.IsNullOrEmpty(@item.n2_redirect))
                            {
                                <li><a href="/@item.Controller/@item.PageName?parentId=@item.n1ID&amp;childId=@item.n2ID&amp;n1_name=Support%20Tools&amp;n2_name=@item.n2_nameLong&amp;submenu=yes">@item.n2_nameLong</a></li>
                            }
                            else
                            {
                                <li><a target="_blank" href="@item.n2_redirect">@item.n2_nameLong</a></li>
                            }
                        }
                    }
                }

                @foreach (var item in ViewBag.list_n2_data_links)
                {
                    string id = Convert.ToString(@item.n2ID);

                    if (@dropdown_pages.Contains(id))
                    {
                        if (string.IsNullOrEmpty(@item.n2_redirect))
                        {
                            <li><a href="/@item.Controller/@item.PageName?parentId=@item.n1ID&amp;childId=@item.n2ID&amp;n1_name=Support%20Tools&amp;n2_name=@item.n2_nameLong&amp;submenu=yes">@item.n2_nameLong</a></li>
                        }
                        else
                        {
                            <li><a target="_blank" href="@item.n2_redirect">@item.n2_nameLong</a></li>
                        }
                    }
                }
                @if (!string.IsNullOrEmpty(ViewBag.interlynxtoken))
                {
                    <li><a target="_blank" href="https://rittal-interlynx.com/srv/sso-autologin?sso_auth_str=@ViewBag.interlynxtoken">View SPA contracts and rebates</a></li>
                }
                @if (!string.IsNullOrEmpty(ViewBag.dealInterlynxToken))
                {
                    <li><a target="_blank" href="https://rittal-interlynx.com/srv/sso-dealautologin?sso_auth_str=@ViewBag.dealInterlynxToken&path=dealregistration_tab%2Frebate_deals_type_active">Register a Deal</a></li>
                }
            </ul>
        </div>
        <iframe src="/Home/stockcheck" style="width:100%;height:250px;margin-top:20px;" frameborder="0" id="iframe"></iframe>
        <iframe src="/Home/webshop" style="width:100%;height:250px;margin-top:20px;" frameborder="0" id="iframe"></iframe>
    </div>
</article>

<style>
    #webshopAccountModal {
        display: none;
        position: fixed;
        z-index: 10000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.6);
        align-items: center;
        justify-content: center;
    }

    #webshopAccountModal .modal-content {
        background-color: #fff;
        margin: auto;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        width: 450px;
        max-width: 90%;
    }

    #webshopAccountModal .modal-header {
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 20px;
        color: #333;
        border-bottom: 2px solid #E50043;
        padding-bottom: 10px;
    }

    #webshopAccountModal .form-group {
        margin-bottom: 20px;
    }

    #webshopAccountModal .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #555;
    }

    #webshopAccountModal .form-group input {
        width: 100%;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
        box-sizing: border-box;
        transition: border-color 0.3s;
        max-width: 100%;
    }

    #webshopAccountModal .form-group input:focus {
        border-color: #E50043;
    }

    #webshopAccountModal .form-group input:hover {
        border-color: #E50043;
    }

    #webshopAccountModal .button-group {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    #webshopAccountModal .btn {
        padding: 10px 25px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        transition: background 0.3s;
    }

    #webshopAccountModal .btn-default {
        border: 1px solid #ccc;
        background: #f5f5f5;
        color: #333;
    }

    #webshopAccountModal .btn-default:hover {
        background: #e0e0e0;
    }

    #webshopAccountModal .btn-primary {
        background: #E50043;
        border: none;
        color: #fff;
    }

    #webshopAccountModal .btn-primary:hover {
        background: #c90038;
    }
</style>

<!-- Online Shop Account Modal -->
<div id="webshopAccountModal" class="modal">
    <div class="modal-content">
        <div class="modal-header" id="webshopModalTitle">Add Online Shop Account</div>
        <input type="hidden" id="webshopEditingAccountId" value="" />
        <div class="form-group">
            <label for="webshopAccountName">Account Name:</label>
            <input type="text" id="webshopAccountName" placeholder="Enter account name" />
        </div>
        <div class="form-group">
            <label for="webshopEmailAddress">Email Address:</label>
            <input type="email" id="webshopEmailAddress" placeholder="Enter email address" />
        </div>
        <div class="form-group">
            <label for="webshopPassword">Password:</label>
            <input type="password" id="webshopPassword" placeholder="Enter password" />
        </div>
        <div class="button-group">
            <button class="btn btn-default" onclick="closeWebshopModal()">Cancel</button>
            <button class="btn btn-primary" onclick="saveWebshopAccount()" id="webshopSaveButton">Save</button>
        </div>
    </div>
</div>

<script>
    // Listen for messages from iframe
    window.addEventListener('message', function(event) {
        if (event.data.type === 'openWebshopModal') {
            openWebshopModal(event.data.mode, event.data.id, event.data.accountName, event.data.emailAddress, event.data.password);
        } else if (event.data.type === 'closeWebshopModal') {
            closeWebshopModal();
        } else if (event.data.type === 'webshopAccountSaved') {
            // Notify iframe to reload accounts
            var iframe = document.querySelector('iframe[src*="/Home/webshop"]');
            if (iframe && iframe.contentWindow) {
                iframe.contentWindow.postMessage({ type: 'reloadWebshopAccounts' }, '*');
            }
        } else if (event.data.type === 'resetSaveButton') {
            resetSaveButton();
        }
    });

    function openWebshopModal(mode, id, accountName, emailAddress, password) {
        if (mode === 'edit') {
            document.getElementById('webshopModalTitle').textContent = 'Edit Online Shop Account';
            document.getElementById('webshopSaveButton').textContent = 'Update';
            document.getElementById('webshopEditingAccountId').value = id;
            document.getElementById('webshopAccountName').value = accountName;
            document.getElementById('webshopEmailAddress').value = emailAddress;
            document.getElementById('webshopPassword').value = password;
        } else {
            document.getElementById('webshopModalTitle').textContent = 'Add Online Shop Account';
            document.getElementById('webshopSaveButton').textContent = 'Save';
            document.getElementById('webshopEditingAccountId').value = '';
            document.getElementById('webshopAccountName').value = '';
            document.getElementById('webshopEmailAddress').value = '';
            document.getElementById('webshopPassword').value = '';
        }
        document.getElementById('webshopAccountModal').style.display = 'block';
    }

    function closeWebshopModal() {
        document.getElementById('webshopAccountModal').style.display = 'none';
        document.getElementById('webshopEditingAccountId').value = '';
        document.getElementById('webshopAccountName').value = '';
        document.getElementById('webshopEmailAddress').value = '';
        document.getElementById('webshopPassword').value = '';
    }

    function saveWebshopAccount() {
        var accountName = document.getElementById('webshopAccountName').value;
        var emailAddress = document.getElementById('webshopEmailAddress').value;
        var password = document.getElementById('webshopPassword').value;
        var editingId = document.getElementById('webshopEditingAccountId').value;
        var saveButton = document.getElementById('webshopSaveButton');

        if (!accountName || !emailAddress || !password) {
            alert('Please fill in all fields');
            return;
        }

        // Disable button and show loading state
        saveButton.disabled = true;
        saveButton.textContent = 'Saving...';
        saveButton.style.opacity = '0.6';

        // Send data to iframe to save
        var iframe = document.querySelector('iframe[src*="/Home/webshop"]');
        if (iframe && iframe.contentWindow) {
            iframe.contentWindow.postMessage({
                type: 'saveWebshopAccount',
                id: editingId,
                accountName: accountName,
                emailAddress: emailAddress,
                password: password
            }, '*');
        }
    }

    function resetSaveButton() {
        var saveButton = document.getElementById('webshopSaveButton');
        saveButton.disabled = false;
        saveButton.textContent = saveButton.textContent === 'Update' ? 'Update' : 'Save';
        saveButton.style.opacity = '1';
    }
</script>
