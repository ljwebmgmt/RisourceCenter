@model IEnumerable<newrisourcecenter.Models.RiSourcesModel>
@{
    ViewBag.Title = "RiSources";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string userProducts = Convert.ToString(Session["userProducts"]);
    string userIndustry = Convert.ToString(Session["userIndustry"]);
}
@*<style>
 .ng-enter  { animation: scaleUp 0.5s both ease-in; z-index: 8888; }
 .ng-leave  { animation: scaleUp 0.5s both ease-in; z-index: 9999; }
</style>*@
<script>
    $(document).ready(function () {
        $("a").click(function (event) {
            $("#sc_body_" + event.target.id).toggleClass("show_sales_comm");
            $("#sc_teaser_" + event.target.id).toggleClass("show_sales_comm");

            if ($("#sc_teaser_" + event.target.id).hasClass("show_sales_comm")) {
                $("#" + event.target.id).css("color", "#fff");
                $("#sc_body_" + event.target.id).css("border", "solid 1px #fff", "padding", "10px");
                $("#sc_body_" + event.target.id).css("padding", "10px");

            } else {
                $("#" + event.target.id).css("color", "#e21785");
            }
        });
    });
</script>

<div class="main_content page" ng-app="resourcesApp">
  <div ng-controller="SearchReSources">
    <div class="content-layout">
        <!-- Filter Sidebar -->
        <aside class="filter-panel">
            <h3>Filters</h3>
            <div class="search-mini" style="margin-bottom:15px;">
                <input type="text" placeholder="Search resources..." id="resourceSearchInput" ng-model="searchbox" ng-keyup="searchRiSource();" />
                <button type="button" ng-click="searchRiSource();" style="padding:8px 12px;background:var(--rittal-red);color:#fff;border:none;cursor:pointer;">⌕</button>
            </div>
            <h4>Resource Type</h4>
            <div class="filter-item">
                <label><input type="checkbox" id="filterAllResources" checked onchange="filterByResourceType('all')" /> All Resources</label>
                <span>@Model.Count()</span>
            </div>
            <div class="filter-item">
                <label><input type="checkbox" class="resource-type-filter" value="PDF" onchange="filterByResourceType('PDF')" /> Documents</label>
                <span>0</span>
            </div>
            <div class="filter-item">
                <label><input type="checkbox" class="resource-type-filter" value="VIDEO" onchange="filterByResourceType('VIDEO')" /> Videos</label>
                <span>0</span>
            </div>
            <div class="filter-item">
                <label><input type="checkbox" class="resource-type-filter" value="IMAGE" onchange="filterByResourceType('IMAGE')" /> Images</label>
                <span>0</span>
            </div>
            <h4>Category</h4>
            @foreach (var items in Model)
            {
                if (@items.sales_submenu != null)
                {
                    foreach (var item in items.sales_submenu)
                    {
                        <div class="filter-item">
                            <label><input type="checkbox" /> @item.n2_longName</label>
                            <span>0</span>
                        </div>
                    }
                }
            }
            <h4>Date Range</h4>
            <div class="filter-item">
                <label><input type="radio" name="dateRange" value="latest" checked onchange="filterByResourceDate('latest')" /> Latest</label>
            </div>
            <div class="filter-item">
                <label><input type="radio" name="dateRange" value="all" onchange="filterByResourceDate('all')" /> All Time</label>
            </div>
            <button type="button" onclick="resetResourceFilters()" style="width:100%;margin-top:15px;padding:8px;background:#f0f0f0;border:1px solid #ddd;border-radius:4px;cursor:pointer;">Reset Filters</button>
        </aside>

        <!-- Main Content -->
        <div class="result-area">
            <div class="result-head">
                <h2>Resources</h2>
                <div class="sort">
                    <span>Sort by:</span>
                    <select>
                        <option>Most Recent</option>
                        <option>Oldest First</option>
                        <option>Alphabetical</option>
                    </select>
                    <div class="toggle">
                        <button class="active" onclick="toggleResourceView('grid')">⊞</button>
                        <button onclick="toggleResourceView('list')">☰</button>
                    </div>
                </div>
            </div>

            <!-- Active Filters -->
            <div align="center" style="margin:10px 0;">
                @{
                    if (Request.QueryString["childid"] != null)
                    {
                        if (Request.QueryString["childid"] != "")
                        {
                            if (@Request.QueryString["grid"] == "1")
                            {
                                <span class="btn btn-info btn-sm">@Request.QueryString["n2_name"] <a href="~/RiSources/?grid=@Request.QueryString["grid"]&n1_name=@Request.QueryString["n1_name"]#!/grid=@Request.QueryString["grid"]" style="color:#ff0000;margin-left:10px;"> X </a></span>
                            }
                            else
                            {
                                if (@Request.QueryString["n2_name"] != "")
                                {
                                    <span class="btn btn-info btn-sm">@Request.QueryString["n2_name"] <a href="~/RiSources/?grid=@Request.QueryString["grid"]&n1_name=@Request.QueryString["n1_name"]#!/grid=@Request.QueryString["grid"]" style="color:#ff0000;margin-left:10px;"> X </a></span>
                                }
                            }
                            if (@Request.QueryString["n2_name"] != "")
                            {
                                <a class="btn btn-info btn-sm" id="reset" href="~/RiSources/?n1_name=@Request.QueryString["n1_name"]">Reset</a>
                            }
                        }
                    }
                }
            </div>

            <!-- Cart Section -->
            <form method="post" action="/RiSources/getReSourcesFiles" enctype="multipart/form-data">
                <input type="hidden" value="@ViewBag.riousrceID" id="countLists"/>
                <div style="background:#f8f9fa;padding:15px;margin-bottom:15px;border-radius:4px;" id="cart">
                    <span class="glyphicon glyphicon-shopping-cart" style="color:#E50043;"></span>
                    <span style="cursor:pointer;text-decoration:underline;margin-left:5px;" ng-click="showCart()" ng-bind="showcart">Show Cart</span>
                    <span ng-bind="countRiSources" style="margin-left:5px;"></span>
                    <div style="display:none;margin-top:10px;" id="hideit" ng-show="download_selected">
                        <ul ng-repeat="items in risourcesModel" style="list-style:none;padding:0;">
                            <li style="padding:5px 0;"><span ng-bind="items.get_headlines"></span>&nbsp;&nbsp;<a href="" ng-click="deleteItem(items.ID,items.ris_ID)">x</a></li>
                        </ul>
                        <button class="btn btn-success" ng-if="risourcesModel.length>0" style="margin-top:10px;">
                            Download Selected
                        </button>
                    </div>
                </div>

                <!-- Resources Grid -->
                <div class="resource-grid" id="resourceGrid">
                    @foreach (var risource in Model.OrderByDescending(a => a.dateCreated))
                    {
                        if (!string.IsNullOrEmpty(userProducts))
                        {
                            foreach (var products in userProducts.ToArray())
                            {
                                if (!string.IsNullOrEmpty(risource.ris_products) && risource.ris_products.Contains(products))
                                {
                                    <article class="resource-card" data-type="@risource.file_type">
                                        <div class="thumb">
                                            @if (@risource.displayimage != "default")
                                            {
                                                <img src="~/attachments/risources/displayImage/@risource.displayimage" style="width:100%;height:100%;object-fit:cover;" alt="@risource.nav2_longName" title="@risource.nav2_longName" />
                                            }
                                            else
                                            {
                                                <img src="~/attachments/risources/displayImage/@risource.n2_headerImg" style="width:100%;height:100%;object-fit:cover;" alt="@risource.nav2_longName" title="@risource.nav2_longName" />
                                            }
                                        </div>
                                        <div class="resource-main">
                                            <span class="resource-type">@risource.file_type</span>
                                            <h3>@risource.ris_headline</h3>
                                            <p>@risource.ris_description</p>
                                            <div class="meta">
                                                <span>@String.Format("{0:d}", @risource.dateCreated)</span>
                                                <span>@risource.file_size KB</span>
                                            </div>
                                        </div>
                                        <div class="actions">
                                            @{
                                                Uri uriResult;
                                                bool result = Uri.TryCreate(@risource.ris_link, UriKind.Absolute, out uriResult)
                                                && (uriResult.Scheme == Uri.UriSchemeHttp
                                                || uriResult.Scheme == Uri.UriSchemeHttps);

                                                if (result)
                                                {
                                                    <button class="btn" ng-click='trackDownload(@risource.ris_ID, "@risource.ris_link")'>Preview</button>
                                                    <a href="@risource.ris_link" target="_blank" class="btn primary">Download</a>
                                                }
                                                else
                                                {
                                                    <button class="btn" ng-click='trackDownload(@risource.ris_ID, "attachments/risources/@risource.ris_link")'>Preview</button>
                                                    <button type="button" class="btn primary" ng-click='trackDownload(@risource.ris_ID, "attachments/risources/@risource.ris_link")'>Download</button>
                                                }
                                            }
                                            @{bool checkings = false;

                                                foreach (var integers in risource.listRisources.ToList())
                                                {
                                                    if (integers == risource.ris_ID)
                                                    {
                                                        <button type="button" class="btn" ng-click="showdownloads(@risource.ris_ID)" id="@risource.ris_ID" name="riousrceID">
                                                            ✓ Added
                                                        </button>
                                                        checkings = true;
                                                        break;
                                                    }
                                                }

                                                if (!checkings)
                                                {
                                                    <button type="button" class="btn" ng-click="showdownloads(@risource.ris_ID)" id="@risource.ris_ID" name="riousrceID">
                                                        + Add to Collection
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </article>
                                    break;
                                }
                            }
                        }
                        else
                        {
                            <article class="resource-card" data-type="@risource.file_type">
                                <div class="thumb">
                                    @if (@risource.displayimage != "default")
                                    {
                                        <img src="~/attachments/risources/displayImage/@risource.displayimage" style="width:100%;height:100%;object-fit:cover;" alt="@risource.nav2_longName" title="@risource.nav2_longName" />
                                    }
                                    else
                                    {
                                        <img src="~/attachments/risources/displayImage/@risource.n2_headerImg" style="width:100%;height:100%;object-fit:cover;" alt="@risource.nav2_longName" title="@risource.nav2_longName" />
                                    }
                                </div>
                                <div class="resource-main">
                                    <span class="resource-type">@risource.file_type</span>
                                    <h3>@risource.ris_headline</h3>
                                    <p>@risource.ris_description</p>
                                    <div class="meta">
                                        <span>@String.Format("{0:d}", @risource.dateCreated)</span>
                                        <span>@risource.file_size KB</span>
                                    </div>
                                </div>
                                <div class="actions">
                                    @{
                                        Uri uriResult;
                                        bool result = Uri.TryCreate(@risource.ris_link, UriKind.Absolute, out uriResult)
                                        && (uriResult.Scheme == Uri.UriSchemeHttp
                                        || uriResult.Scheme == Uri.UriSchemeHttps);

                                        if (result)
                                        {
                                            <button class="btn" ng-click='trackDownload(@risource.ris_ID, "@risource.ris_link")'>Preview</button>
                                            <a href="@risource.ris_link" target="_blank" class="btn primary">Download</a>
                                        }
                                        else
                                        {
                                            <button class="btn" ng-click='trackDownload(@risource.ris_ID, "attachments/risources/@risource.ris_link")'>Preview</button>
                                            <button type="button" class="btn primary" ng-click='trackDownload(@risource.ris_ID, "attachments/risources/@risource.ris_link")'>Download</button>
                                        }
                                    }
                                    @{bool checkings = false;

                                        foreach (var integers in risource.listRisources.ToList())
                                        {
                                            if (integers == risource.ris_ID)
                                            {
                                                <button type="button" class="btn" ng-click="showdownloads(@risource.ris_ID)" id="@risource.ris_ID" name="riousrceID">
                                                    ✓ Added
                                                </button>
                                                checkings = true;
                                                break;
                                            }
                                        }

                                        if (!checkings)
                                        {
                                            <button type="button" class="btn" ng-click="showdownloads(@risource.ris_ID)" id="@risource.ris_ID" name="riousrceID">
                                                + Add to Collection
                                            </button>
                                        }
                                    }
                                </div>
                            </article>
                        }
                    }
                </div>

                <!-- Pagination -->
                <div class="pagination">
                    <button>‹</button>
                    <button class="active">1</button>
                    <button>2</button>
                    <button>3</button>
                    <button>›</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function toggleResourceView(mode) {
        var grid = document.getElementById('resourceGrid');
        if (mode === 'list') {
            grid.classList.add('list-mode');
        } else {
            grid.classList.remove('list-mode');
        }
    }

    function resetResourceFilters() {
        window.location.href = '?n1_name=' + '@Request.QueryString["n1_name"]';
    }

    function filterByResourceType(type) {
        var cards = document.querySelectorAll('.resource-card');
        cards.forEach(function(card) {
            var cardType = card.getAttribute('data-type');
            if (type === 'all' || cardType === type) {
                card.style.display = 'grid';
            } else {
                card.style.display = 'none';
            }
        });
    }

    function filterByResourceDate(dateRange) {
        var url = new URL(window.location.href);
        if (dateRange === 'all') {
            url.searchParams.set('recent', 'all');
        } else {
            url.searchParams.set('recent', 'latest');
        }
        window.location.href = url.toString();
    }
</script>
